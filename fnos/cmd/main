#!/bin/bash
# FPK 生命周期入口 (cmd/main)：start | stop | status
# 也用于 NAS 上手工启停。配置读取 fnos.env。
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
ENV_FILE="$ROOT/fnos.env"
PID_FILE="$ROOT/runtime/app.pid"
LOG_FILE="$ROOT/runtime/app.log"

[ -f "$ENV_FILE" ] || { echo "缺少 $ENV_FILE，请先执行 fnos/deploy.sh"; exit 1; }
set -a; . "$ENV_FILE"; set +a
PY="$ROOT/.venv-linux/bin/python"

start() {
  if status >/dev/null 2>&1; then echo "已在运行"; exit 0; fi
  mkdir -p "$ROOT/runtime" "$ROOT/config"
  cd "$ROOT"
  nohup "$PY" app/main.py >>"$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 2
  if status >/dev/null 2>&1; then
    echo "已启动 (pid $(cat "$PID_FILE"))，端口 ${PORT:-3011}，日志 $LOG_FILE"
  else
    echo "启动失败，请查看 $LOG_FILE"; exit 1
  fi
}

stop() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    sleep 2
    kill -9 "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "已停止"
  else
    echo "未在运行"
  fi
}

status() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "running"; return 0
  fi
  echo "stopped"; return 1
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) echo "用法: $0 {start|stop|status}"; exit 1 ;;
esac
