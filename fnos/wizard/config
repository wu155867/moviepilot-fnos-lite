[
  {
    "stepTitle": "修改服务端口",
    "items": [
      {
        "type": "tips",
        "helpText": "只有在需要更换端口时才填写此项。留空表示保持当前端口不变。\\n如果你在浏览器里访问的是 http://NAS地址:3011，那么当前端口就是 3011。\\n保存后应用会自动重启并在新端口上提供服务，桌面图标也会指向新端口。"
      },
      {
        "type": "text",
        "field": "wizard_port",
        "label": "新端口（留空不改）",
        "initValue": "",
        "helpText": "填 1-65535 之间的数字",
        "rules": [
          {
            "pattern": "^$|^([1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "留空，或填写 1-65535 之间的端口号（只能填数字）"
          }
        ]
      }
    ]
  }
]
