#!/bin/bash
# FPK 生命周期: start | stop | status
# 1.0.6: 以 root 执行（用于同步系统侧的端口登记），实际服务进程用 setpriv 降权到应用用户
set -u
APP_NAME="moviepilot-fnos-lite"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="$(cd "$SELF_DIR/../target" 2>/dev/null && pwd)"
if [ ! -d "$APP_DIR" ]; then APP_DIR="$(cd "$SELF_DIR/../payload" 2>/dev/null && pwd)"; fi
if [ ! -d "$APP_DIR" ]; then APP_DIR="/vol1/@appcenter/$APP_NAME"; fi
VAR_DIR="${TRIM_PKGVAR:-/vol1/@appdata/$APP_NAME}"
PORT_FILE="$VAR_DIR/port"
PID_FILE="$VAR_DIR/app.pid"
LOG_DIR="$VAR_DIR/log"
LOG_FILE="$LOG_DIR/app.log"
SYNC_LOG="$LOG_DIR/port_sync.log"
MANIFEST="/var/apps/$APP_NAME/manifest"
DEFAULT_PORT=3011
mkdir -p "$VAR_DIR/config" "$LOG_DIR"

valid_port() {
  case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

# 端口来源优先级：持久化文件 > 向导值 > manifest > 系统注入 > 默认
pick_port() {
  local p
  p="$(tr -dc '0-9' < "$PORT_FILE" 2>/dev/null)"
  if valid_port "$p"; then echo "$p"; return; fi
  if valid_port "${wizard_port:-}"; then echo "$wizard_port"; return; fi
  p="$(awk -F= '/^[[:space:]]*service_port[[:space:]]*=/{gsub(/[^0-9]/,"",$2); print $2}' "$MANIFEST" 2>/dev/null | head -1)"
  if valid_port "$p"; then echo "$p"; return; fi
  if valid_port "${TRIM_SERVICE_PORT:-}"; then echo "$TRIM_SERVICE_PORT"; return; fi
  echo "$DEFAULT_PORT"
}

is_running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
}

port_in_use() {
  ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"
}

# 端口被占用时，判断占用者是不是我们自己（appcenter 可能已经拉起过一次）
port_owner_is_self() {
  local pid
  pid="$(ss -ltnp 2>/dev/null | awk -v p=":$1\$" '$4 ~ p' | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)"
  [ -n "$pid" ] && ps -o args= -p "$pid" 2>/dev/null | grep -q "app/main.py"
}

status() {
  if is_running; then echo running; exit 0; fi
  echo stopped; exit 3
}

start() {
  if is_running; then exit 0; fi
  local PORT
  PORT="$(pick_port)"
  echo "$PORT" > "$PORT_FILE"

  # 生命周期脚本以 root 运行，运行数据目录统一交还给应用用户
  if [ "$(id -u)" = "0" ] && [ -n "${TRIM_UID:-}" ]; then
    chown -R "${TRIM_UID}:${TRIM_GID}" "$VAR_DIR" 2>/dev/null || true
  fi

  # 同步系统侧三处端口登记（仅 root 可做）：ui/config、manifest、appcenter 库
  if [ "$(id -u)" = "0" ] && [ -f "$SELF_DIR/port_sync.py" ]; then
    python3 "$SELF_DIR/port_sync.py" "$PORT" "$APP_NAME" "$APP_DIR" "$SELF_DIR/.." >> "$SYNC_LOG" 2>&1 || true
  fi

  if port_in_use "$PORT"; then
    if port_owner_is_self "$PORT"; then
      ss -ltnp 2>/dev/null | awk -v p=":$PORT\$" '$4 ~ p' | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2 > "$PID_FILE"
      exit 0
    fi
    echo "端口 $PORT 已被其他程序占用。请打开「应用中心 → MP入库助手 → 设置」，填写一个空闲端口后保存。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    echo "[$(date -Is)] start aborted: port $PORT already in use" >> "$LOG_FILE"
    exit 1
  fi

  local PY="$APP_DIR/.venv-linux/bin/python"
  [ -x "$PY" ] || { echo "内置运行时缺失：$PY" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"; exit 1; }

  touch "$LOG_FILE"
  local RUN_AS=""
  if [ "$(id -u)" = "0" ] && [ -n "${TRIM_UID:-}" ] && [ -n "${TRIM_GID:-}" ]; then
    RUN_AS="setpriv --reuid=${TRIM_UID} --regid=${TRIM_GID} --init-groups --inh-caps=-all"
    chown "${TRIM_UID}:${TRIM_GID}" "$LOG_FILE" 2>/dev/null || true
  fi

  cd "$APP_DIR" || exit 1
  HOME="$VAR_DIR" PORT="$PORT" HOST="0.0.0.0" CONFIG_DIR="$VAR_DIR/config" PYTHONPATH="$APP_DIR" \
    nohup $RUN_AS "$PY" app/main.py >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"

  local i
  for i in 1 2 3; do
    sleep 2
    if curl -s -m 2 -o /dev/null "http://127.0.0.1:$PORT/"; then exit 0; fi
    is_running || { echo "启动失败，请查看日志：$LOG_FILE" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"; exit 1; }
  done
  exit 0
}

# 杀掉登记端口上的本应用进程（pidfile 丢失时的兜底）
kill_port_owner() {
  local cur op
  cur="$1"
  valid_port "$cur" || return 0
  op="$(ss -ltnp 2>/dev/null | awk -v p=":$cur\$" '$4 ~ p' | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)"
  [ -n "$op" ] || return 0
  ps -o args= -p "$op" 2>/dev/null | grep -q "app/main.py" || return 0
  kill "$op" 2>/dev/null || true
  sleep 1
  kill -9 "$op" 2>/dev/null || true
}

stop() {
  local P="" CUR
  if [ -f "$PID_FILE" ]; then
    P="$(cat "$PID_FILE" 2>/dev/null)"
    [ -n "$P" ] && kill "$P" 2>/dev/null || true
    local i
    for i in 1 2 3; do
      kill -0 "$P" 2>/dev/null || break
      sleep 1
    done
    kill -9 "$P" 2>/dev/null || true
  fi
  # 兜底：pidfile 丢失、或改端口后旧实例仍在旧端口上
  CUR="$(tr -dc '0-9' < "$PORT_FILE" 2>/dev/null)"
  kill_port_owner "$CUR"
  # 兼容软链路径与真实路径两种 cmdline 写法
  pkill -f "$APP_NAME/.venv-linux/bin/python app/main.py" 2>/dev/null || true
  rm -f "$PID_FILE"
  exit 0
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) exit 0 ;;
esac
