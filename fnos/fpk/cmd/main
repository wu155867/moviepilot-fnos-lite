#!/bin/bash
# FPK 生命周期: start | stop | status
set -u
APP_DIR="$(cd "$(dirname "$0")/../target" 2>/dev/null && pwd)"
if [ ! -d "$APP_DIR" ]; then APP_DIR="$(cd "$(dirname "$0")/../payload" 2>/dev/null && pwd)"; fi
if [ ! -d "$APP_DIR" ]; then APP_DIR="/vol1/@appcenter/moviepilot-fnos-lite"; fi
VAR_DIR="${TRIM_PKGVAR:-$APP_DIR/../var}"
PID_FILE="$VAR_DIR/app.pid"
LOG_DIR="$VAR_DIR/log"
LOG_FILE="$LOG_DIR/app.log"
mkdir -p "$VAR_DIR/config" "$LOG_DIR"

export HOST="${HOST:-0.0.0.0}"
export PORT="${PORT:-3011}"
export CONFIG_DIR="$VAR_DIR/config"
export PYTHONPATH="$APP_DIR"
PY="$APP_DIR/.venv-linux/bin/python"

status() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo running; return 0
  fi
  echo stopped; return 3
}

start() {
  if status >/dev/null 2>&1; then exit 0; fi
  cd "$APP_DIR"
  nohup "$PY" app/main.py >>"$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  for i in $(seq 1 3); do
    sleep 2
    if curl -s -m 2 -o /dev/null "http://127.0.0.1:$PORT/"; then exit 0; fi
    kill -0 "$(cat "$PID_FILE")" 2>/dev/null || { echo "启动失败，见 $LOG_FILE" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}"; exit 1; }
  done
  exit 0
}

stop() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    for i in $(seq 1 3); do
      kill -0 "$(cat "$PID_FILE")" 2>/dev/null || break
      sleep 1
    done
    kill -9 "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
  exit 0
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) exit 0 ;;
esac
